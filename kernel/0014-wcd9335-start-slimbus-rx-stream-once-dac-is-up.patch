--- a/sound/soc/codecs/wcd9335.c	2026-11-09 19:41:50
+++ b/sound/soc/codecs/wcd9335.c	2026-11-09 20:38:24
@@ -293,6 +293,8 @@
 	struct list_head slim_ch_list;
 	struct slim_stream_config sconfig;
 	struct slim_stream_runtime *sruntime;
+	bool stream_enabled;
+	bool path_powered;	/* playback AIF widget is powered */
 };
 
 struct wcd9335_codec {
@@ -326,6 +328,7 @@
 	struct wcd_clsh_ctrl *clsh_ctrl;
 	u32 hph_mode;
 	int prim_int_users[WCD9335_NUM_INTERPOLATORS];
+	int rx_dac_users;	/* powered RX DACs (EAR, HPH, LINEOUT) */
 
 	int comp_enabled[COMPANDER_MAX];
 
