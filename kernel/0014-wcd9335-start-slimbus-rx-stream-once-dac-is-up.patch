@@ -3515,6 +3707,7 @@
 				WCD_CLSH_STATE_HPHL,
 				((hph_mode == CLS_H_LOHIFI) ?
 				 CLS_H_HIFI : hph_mode));
+		wcd9335_slim_rx_dac_down(wcd);
 		break;
